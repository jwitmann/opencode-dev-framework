#!/usr/bin/env node
// df — opencode-dev-framework CLI installer.
// Scaffold project-level agents, skills, local rules, and config into a repo.

import { readFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import {
  installTemplates,
  resolveTargetDir,
  setProfileInFile,
  statusTemplates,
  writeDetectedConfig,
} from "../dist/installer.js";

async function getVersion() {
  const packagePath = join(dirname(fileURLToPath(import.meta.url)), "..", "package.json");
  const pkg = JSON.parse(await readFile(packagePath, "utf8"));
  return pkg.version ?? "unknown";
}

function printHelp() {
  console.log(`df — opencode-dev-framework project installer

Usage:
  df init [dir]        Scaffold templates into a project (default: cwd)
  df profile <name> [dir]  Set profile to off, advisory, standard, or strict
  df status [dir]      Show which template files are missing/present/different
  df version           Print the plugin version
  df help              Show this help

Options:
  --overwrite-existing  Overwrite files that already exist (non-interactive)
  --skip-existing       Skip files that already exist (non-interactive)
`);
}

function formatList(label, files) {
  if (files.length === 0) {
    return [`${label}: (none)`];
  }
  return [`${label}:`, ...files.map((file) => `  - ${file}`)];
}

async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  if (!command || command === "help" || command === "--help" || command === "-h") {
    printHelp();
    return;
  }

  if (command === "version" || command === "--version" || command === "-v") {
    console.log(await getVersion());
    return;
  }

  const flags = new Set(args.slice(1).filter((arg) => arg.startsWith("--")));
  const positional = args.slice(1).filter((arg) => !arg.startsWith("--"));

  if (command === "profile") {
    const profile = positional[0];
    const profileDir = resolveTargetDir(positional[1]);
    const valid = ["off", "advisory", "standard", "strict"];
    if (!profile || !valid.includes(profile)) {
      console.error(`Invalid profile: ${profile ?? "(missing)"}`);
      console.error(`Valid profiles: ${valid.join(", ")}`);
      process.exitCode = 1;
      return;
    }
    const configPath = join(profileDir, ".opencode-dev-framework.yml");
    await setProfileInFile(configPath, profile);
    console.log(`Profile set to "${profile}" in ${configPath}`);
    return;
  }

  if (command !== "init" && command !== "status") {
    console.error(`Unknown command: ${command}`);
    printHelp();
    process.exitCode = 1;
    return;
  }

  const targetDir = resolveTargetDir(positional[0]);

  if (command === "init" && flags.has("--skip-existing") && flags.has("--overwrite-existing")) {
    console.error("Cannot use both --skip-existing and --overwrite-existing");
    process.exitCode = 1;
    return;
  }

  if (command === "status") {
    const status = await statusTemplates(targetDir);
    console.log(`Template status for ${targetDir}:`);
    for (const line of [
      ...formatList("Missing", status.missing),
      ...formatList("Present", status.present),
      ...formatList("Different", status.different),
    ]) {
      console.log(line);
    }
    return;
  }

  const result = await installTemplates(targetDir, {
    overwriteExisting: flags.has("--overwrite-existing"),
    skipExisting: flags.has("--skip-existing"),
  });

  const configResult = await writeDetectedConfig(targetDir, {
    overwriteExisting: flags.has("--overwrite-existing"),
    skipExisting: flags.has("--skip-existing"),
  });

  console.log(`Installed templates into ${targetDir}:`);
  for (const line of [
    ...formatList("Created", result.created),
    ...formatList("Overwritten", result.overwritten),
    ...formatList("Skipped", result.skipped),
  ]) {
    console.log(line);
  }
  console.log(`\nConfig: ${configResult.action}`);
}

main().catch((error) => {
  console.error(error instanceof Error ? error.message : String(error));
  process.exitCode = 1;
});
